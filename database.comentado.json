{

  "rules": {
    /*
      REGLAS DE SEGURIDAD - Invernadero (Firebase Realtime Database)
      Principio: todo está DENEGADO por defecto y solo se abre lo estrictamente necesario.
      Roles: 'admin' y 'usuario' (campo usuarios/<uid>/perfil/rol). Una cuenta con activo=false pierde el acceso.
      '.read' / '.write' = quién puede leer / escribir.   '.validate' = qué datos se aceptan.
    */

    // Por defecto NADIE puede leer ni escribir. Cada sección abre solo lo que necesita.
    ".read": false,
    ".write": false,

    // ================= USUARIOS: perfiles y roles =================
    // Lectura de TODOS los perfiles: solo un admin activo (para el panel de administración).
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
      // Cada usuario puede leer solo su propio nodo (su rol y su estado).
      // Escribir en un nodo de usuario (cambiar rol/activo) solo puede un admin activo.
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
        // Un usuario puede CREAR su propio perfil una sola vez (!data.exists()), pero SOLO como 'usuario' y activo,
        // y con el correo de su propia cuenta. Así nadie se puede registrar a sí mismo como admin.
        "perfil": {
          ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('rol').val() === 'usuario' && newData.child('activo').val() === true && newData.child('email').val() === auth.token.email",
          ".validate": "newData.hasChildren(['email', 'rol', 'activo'])",
          // Validaciones de forma: correo texto <=100, rol solo 'usuario'/'admin', activo booleano; no se aceptan campos extra.
          "email": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "rol": { ".validate": "newData.val() === 'usuario' || newData.val() === 'admin'" },
          "activo": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    // ================= DISPOSITIVOS: ESP32 / simulador =================
    // Todo lo de un dispositivo requiere cuenta ACTIVA; lo sensible exige admin.
    "dispositivos": {
      "$deviceId": {
        // --- sensores: última lectura de temperatura y humedad (la escribe el ESP32/simulador) ---
        // Rangos físicos razonables para rechazar datos corruptos o manipulados.
        "sensores": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".validate": "newData.hasChildren(['temperatura', 'humedadAire', 'timestamp'])",
          "temperatura": { ".validate": "newData.isNumber() && newData.val() >= -60 && newData.val() <= 100" },
          "humedadAire": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        // --- estado: conexión del dispositivo. 'ultimaConexion' es el latido (heartbeat) para saber si está en línea;
        // 'simulador' es el 'turno' que evita que dos teléfonos simulen datos a la vez. ---
        "estado": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          "online": { ".validate": "newData.isBoolean()" },
          "ultimaConexion": { ".validate": "newData.isNumber()" },
          "simulador": {
            ".validate": "newData.hasChildren(['id', 'ts'])",
            "id": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "ts": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        // --- comandos: encendido/apagado de cada actuador (true/false) ---
        "comandos": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          "bomba": { ".validate": "newData.isBoolean()" },
          "ventilador": { ".validate": "newData.isBoolean()" },
          "bocina": { ".validate": "newData.isBoolean()" },
          "led": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        // --- modos: cada actuador está en 'auto' (lo maneja la automatización) o 'manual' (lo maneja el usuario) ---
        "modos": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          "$act": { ".validate": "($act === 'bomba' || $act === 'ventilador' || $act === 'bocina' || $act === 'led') && (newData.val() === 'auto' || newData.val() === 'manual')" }
        },
        // --- lecturas: historial para las gráficas. Buffer circular de hasta 1440 posiciones (1 por minuto, 24 h).
        // $slot debe ser un número de 1 a 4 dígitos; cada lectura exige temperatura, humedad y timestamp. ---
        "lecturas": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          "$slot": {
            ".validate": "$slot.matches(/^[0-9]{1,4}$/) && newData.hasChildren(['temperatura', 'humedadAire', 'timestamp'])",
            "temperatura": { ".validate": "newData.isNumber() && newData.val() >= -60 && newData.val() <= 100" },
            "humedadAire": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "timestamp": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        // --- thresholds: umbrales de automatización y de alarma ---
        // Leer: cualquier cuenta activa. ESCRIBIR: solo admin activo.
        // La validación exige que cada 'Min' sea menor que su 'Max' y limita los rangos permitidos.
        "thresholds": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".validate": "newData.hasChildren(['temperaturaMax', 'temperaturaMin', 'humedadAireMax', 'humedadAireMin', 'automatizacionActiva', 'alertaTemperaturaMax', 'alertaTemperaturaMin', 'alertaHumedadMax', 'alertaHumedadMin']) && newData.child('temperaturaMin').val() < newData.child('temperaturaMax').val() && newData.child('humedadAireMin').val() < newData.child('humedadAireMax').val() && newData.child('alertaTemperaturaMin').val() < newData.child('alertaTemperaturaMax').val() && newData.child('alertaHumedadMin').val() < newData.child('alertaHumedadMax').val()",
          "temperaturaMax": { ".validate": "newData.isNumber() && newData.val() >= -5 && newData.val() <= 20" },
          "temperaturaMin": { ".validate": "newData.isNumber() && newData.val() >= -5 && newData.val() <= 20" },
          "humedadAireMax": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "humedadAireMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "automatizacionActiva": { ".validate": "newData.isBoolean()" },
          "alertaTemperaturaMax": { ".validate": "newData.isNumber() && newData.val() >= -5 && newData.val() <= 25" },
          "alertaTemperaturaMin": { ".validate": "newData.isNumber() && newData.val() >= -10 && newData.val() <= 20" },
          "alertaHumedadMax": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "alertaHumedadMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
          "$other": { ".validate": false }
        },
        // --- historial (antiguo): solo lectura para admin; nadie puede escribir ---
        "historial": {
          ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
          ".write": false
        }
      }
    },

    // ================= REGISTROS: bitácora de auditoría (solo admin la ve) =================
    // Leer: solo admin activo. Categorías: sesiones, cuentas, dispositivos, configuracion, alertas.
    "registros": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('perfil').child('rol').val() === 'admin' && root.child('usuarios').child(auth.uid).child('perfil').child('activo').val() === true",
      "$categoria": {
        // Escritura APPEND-ONLY: solo se puede crear (!data.exists()); nadie puede editar ni borrar un registro.
        // Sin sesión solo se permiten 3 eventos de la categoría 'sesiones' (login fallido, bloqueo, recuperación)
        // porque ocurren antes de iniciar sesión; el resto exige estar autenticado.
        "$id": {
          ".write": "!data.exists() && newData.exists() && $categoria.matches(/^(sesiones|cuentas|dispositivos|configuracion|alertas)$/) && (auth != null || ($categoria === 'sesiones' && (newData.child('tipo').val() === 'LOGIN_FALLIDO' || newData.child('tipo').val() === 'CUENTA_BLOQUEADA' || newData.child('tipo').val() === 'RECUPERACION_SOLICITADA')))",
          ".validate": "newData.hasChildren(['tipo', 'detalle', 'usuario', 'uid', 'timestamp'])",
          // Campos del registro: 'tipo' en MAYÚSCULAS_CON_GUION; 'usuario' debe ser el correo de quien escribe (o 'Sistema')
          // y 'uid' el suyo, así no se puede suplantar a otra persona; 'timestamp' debe ser la hora del servidor (now).
          "tipo": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z_]+$/) && newData.val().length >= 3 && newData.val().length <= 40" },
          "detalle": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "usuario": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100 && (auth == null || newData.val() === auth.token.email || newData.val() === 'Sistema')" },
          "uid": { ".validate": "newData.isString() && newData.val() === (auth != null ? auth.uid : '')" },
          "timestamp": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    // ================= BLOQUEOS: intentos fallidos de inicio de sesión =================
    // Lectura pública (la app debe consultar el bloqueo ANTES de iniciar sesión).
    "bloqueos": {
      "$clave": {
        ".read": true,
        // Escritura: máquina de estados que impide trampas. Solo se permite:
        //  1) El dueño de la cuenta (ya autenticado) borra su bloqueo (tras restablecer contraseña).
        //  2) Crear el primer intento fallido (intentos=1, sin bloquear).
        //  3) Sumar exactamente +1 intento; al llegar a 5 se marca bloqueado=true.
        //  4) Si está bloqueado: marcar/desmarcar 'resetSolicitado' (solicitud de recuperar contraseña) sin cambiar intentos.
        // La clave es el correo en minúsculas con '.' cambiado por ',' (Firebase no admite puntos en las claves).
        ".write": "$clave.matches(/^[a-z0-9_%+@,-]+$/) && $clave.length >= 3 && $clave.length <= 150 && ((!newData.exists() && auth != null && auth.token.email.toLowerCase().replace('.', ',') === $clave) || (!data.exists() && newData.child('intentos').val() === 1 && newData.child('bloqueado').val() === false && newData.child('resetSolicitado').val() === false) || (data.exists() && data.child('bloqueado').val() === false && newData.child('intentos').val() === data.child('intentos').val() + 1 && newData.child('bloqueado').val() === (newData.child('intentos').val() >= 5) && newData.child('resetSolicitado').val() === false) || (data.child('bloqueado').val() === true && data.child('resetSolicitado').val() === false && newData.child('bloqueado').val() === true && newData.child('resetSolicitado').val() === true && newData.child('intentos').val() === data.child('intentos').val()) || (data.child('bloqueado').val() === true && data.child('resetSolicitado').val() === true && newData.child('bloqueado').val() === true && newData.child('resetSolicitado').val() === false && newData.child('intentos').val() === data.child('intentos').val()))",
        ".validate": "newData.hasChildren(['intentos', 'bloqueado', 'resetSolicitado'])",
        // Validaciones: intentos entre 1 y 5; bloqueado y resetSolicitado booleanos; no se aceptan campos extra.
        "intentos": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "bloqueado": { ".validate": "newData.isBoolean()" },
        "resetSolicitado": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
